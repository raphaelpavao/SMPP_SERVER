# Copie para .env e ajuste. O .env NÃO vai para o git.

JASMIN_VERSION=0.11.0

# Administração do Jasmin (jcli). TROQUE em produção.
JCLI_USER=jcliadmin
JCLI_PASSWORD=jclipwd

# Porta SMPP que os clientes usam. Em produção, restrinja por firewall.
SMPP_BIND=0.0.0.0
SMPP_PORT=2775

# Portas locais (só 127.0.0.1)
JCLI_PORT=8990
HTTP_API_PORT=1401
RABBITMQ_ADMIN_PORT=15672

# Jasmin Web Panel (perfil painel). Gere a chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
PAINEL_VERSION=3.1.0
PAINEL_PORT=8999
PAINEL_SECRET_KEY=troque-esta-chave
PAINEL_DB_PASSWORD=painel

# Simulador de SMSC (perfil dev)
SIM_PORT=2776
SIM_SYSTEM_ID=simulador
SIM_PASSWORD=sim123
# Mensagens para números que começam com este prefixo voltam como MO (eco)
SIM_ECO_PREFIXO=5500

# Portal TIP (perfil portal): gestão de provedores e DIDs.
# Gere a chave com o mesmo comando do PAINEL_SECRET_KEY.
PORTAL_PORT=8000
PORTAL_SECRET_KEY=troque-esta-chave
PORTAL_DB_PASSWORD=portal
PORTAL_ALLOWED_HOSTS=localhost,127.0.0.1
PORTAL_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Usuário "portal" no Jasmin (máx. 8 caracteres) e token das rotas internas de
# DLR/MO. Os mesmos valores vão para o Jasmin pelo provisionar (gateway.json).
PORTAL_JASMIN_SENHA=ptl2026x
PORTAL_INTERNO_TOKEN=troque-este-token
# Administrador criado no primeiro start. Troque a senha pelo portal depois.
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=
